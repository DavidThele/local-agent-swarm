# Copy this file to `.env`, uncomment required lines, and fill in values before running.

# Google Cloud project ID (for example: gen-lang-client-123456).
# GOOGLE_CLOUD_PROJECT=

# Google Cloud location or region (for example: global or us-central1).
GOOGLE_CLOUD_LOCATION=global

# Use Google Cloud Vertex AI (True) instead of the Gemini Developer API (False).
GOOGLE_GENAI_USE_ENTERPRISE=True

# Path to Google Application Default Credentials JSON. Replace <username> with your local username.
# GOOGLE_APPLICATION_CREDENTIALS=/Users/<username>/.config/gcloud/application_default_credentials.json

# Routing backend mode ("web" or "api").
PROMPT_ROUTER_BACKEND=web

# Maximum time in seconds allowed for a single agent thinking turn.
AGENT_THINKING_TIMEOUT_SECONDS=300

# Automatically populated in `.env` on the first run of the MCP server if left unset.
# MCP_CLIENT_ID=
# MCP_CLIENT_SECRET=
# MCP_AUTH_TOKEN=